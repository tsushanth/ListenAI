# ReadAloud AI TTS Service - GPU Version
# Supports: Kokoro-82M (fast TTS) and Chatterbox (voice cloning)
# For Cloud Run with NVIDIA L4 GPU

FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
# espeak-ng is required for Kokoro phoneme processing
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3.10-venv \
    python3.10-dev \
    ffmpeg \
    libsndfile1 \
    git \
    curl \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

# Set Python aliases (use Python 3.10 which is better supported by Ubuntu 22.04)
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1
RUN update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# Create app directory
WORKDIR /app

# Create directories for voice samples and cache
RUN mkdir -p /app/voice_samples /app/audio_cache

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies with CUDA support
# Use CUDA 11.8 compatible torch 2.6.0 for Chatterbox compatibility
# Install numpy and build tools first (required by pkuseg build which is a Chatterbox dependency)
# Use --no-build-isolation for chatterbox-tts to use the system numpy for pkuseg build
RUN pip install --no-cache-dir --upgrade pip setuptools wheel cython && \
    pip install --no-cache-dir "numpy>=1.24.0,<1.26.0" && \
    pip install --no-cache-dir torch==2.6.0 torchaudio==2.6.0 --index-url https://download.pytorch.org/whl/cu118 && \
    pip install --no-cache-dir --no-build-isolation "chatterbox-tts>=0.1.4,<0.2.0" && \
    pip install --no-cache-dir -r requirements.txt

# Set HuggingFace cache directory to persist in image
ENV HF_HOME=/app/.cache/huggingface
ENV HUGGINGFACE_HUB_CACHE=/app/.cache/huggingface/hub
# Auto-accept Coqui TTS license (required for non-interactive XTTS usage)
ENV COQUI_TOS_AGREED=1
RUN mkdir -p /app/.cache/huggingface/hub

# Copy model download script
COPY download_models.py .

# Pre-download all models and voices (baked into image for fast cold starts)
# Downloads Kokoro-82M with voice packs and Chatterbox model
RUN python download_models.py

# Copy application code
COPY main.py .

# Environment variables
ENV PORT=8080
ENV DEFAULT_TTS_MODEL=kokoro
ENV VOICE_SAMPLES_DIR=/app/voice_samples
ENV AUDIO_CACHE_DIR=/app/audio_cache
ENV CACHE_ENABLED=true
ENV LOG_LEVEL=INFO
# Auto-accept Coqui TTS license for XTTS at runtime
ENV COQUI_TOS_AGREED=1

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the service
CMD ["python", "main.py"]

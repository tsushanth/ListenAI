{
  "name": "listenai-backend",
  "version": "1.0.0",
  "description": "Cloud Run backend for Listen AI TTS service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/runWorker.ts",
    "worker:dev": "tsx watch src/runWorker.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/realtimeTtsBilling.test.ts"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "supabase",
    "cloud-run"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.39.0",
    "@types/nodemailer": "^7.0.5",
    "axios": "^1.6.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jose": "^5.2.0",
    "jsdom": "^27.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.12",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0",
    "stripe": "^14.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^27.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

# =============================================================================
# Listen AI Backend - Environment Variables
# =============================================================================
#
# For deployment:
#   1. Copy this file to .env.production
#   2. Fill in your values
#   3. Run: ./deploy.sh
#
# For local development:
#   1. Copy this file to .env
#   2. Fill in your values
#   3. Run: npm run dev
#
# DO NOT commit .env or .env.production to version control!
# =============================================================================

# Server
PORT=8080
NODE_ENV=development

# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# TTS Providers
# =============================================================================
# Optional: OpenAI API key for future OpenAI TTS support
OPENAI_API_KEY=

# =============================================================================
# Self-Hosted TTS Service (Kokoro) - CPU Fallback
# =============================================================================
# URL of your self-hosted Kokoro TTS service on Cloud Run (CPU)
# This is used as a fallback when GPU is unavailable

SELFHOSTED_TTS_URL=https://readaloud-tts-917362189743.us-central1.run.app

# Optional: API key for self-hosted TTS service
SELFHOSTED_TTS_API_KEY=

# =============================================================================
# GPU TTS Service (Primary - Fast Inference)
# =============================================================================
# URL of GPU-enabled TTS service for faster synthesis
# When enabled, GPU is used as primary with CPU as fallback

GPU_TTS_URL=https://readaloud-tts-gpu-917362189743.us-central1.run.app
GPU_TTS_ENABLED=false

# =============================================================================
# Rate Limiting
# =============================================================================
# Requests per window (default: 60 requests per minute)

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# =============================================================================
# GCP Configuration (for deploy.sh)
# =============================================================================
# Override these if deploying to a different project/region

GCP_PROJECT_ID=summarizerproxy
GCP_REGION=us-central1

# =============================================================================
# TTS Job Worker Configuration
# =============================================================================
# Enable embedded TTS job worker (processes async job queue)
# Set to 'true' to enable, 'false' or omit to disable

TTS_WORKER_ENABLED=false

# Worker poll interval in milliseconds (how often to check for new jobs)
WORKER_POLL_INTERVAL_MS=2000

# Maximum retry attempts for failed jobs
WORKER_MAX_RETRIES=3

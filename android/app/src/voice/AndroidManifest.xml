<?xml version="1.0" encoding="utf-8"?>
<!--
    voice-flavor manifest overlay.
    Merged on top of src/main/AndroidManifest.xml when assembleVoice* runs.
    Purpose: launch into the TTS voice picker instead of the reader's
    MainActivity. The reader UI is still in the APK but the user never
    sees it from the launcher.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <!-- Strip MainActivity's intent filters so it's no longer a
             launcher entry. tools:node="removeAll" applied here removes
             ALL children (the LAUNCHER intent-filter, the OAuth deep-link
             filter). MainActivity itself remains so internal start
             attempts don't NPE. -->
        <activity android:name=".MainActivity">
            <intent-filter tools:node="removeAll" />
        </activity>

        <!-- Activity-alias forwards the LAUNCHER intent to the TTS voice
             picker. No new Kotlin needed — Android handles the
             redirect at component-resolution time. -->
        <activity-alias
            android:name=".VoicePickerLauncher"
            android:targetActivity=".systemtts.TTSEngineSettingsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <!-- ===== System TTS engine and eSpeak NG (GPL-3.0). Voice flavor only; see android/GPL.md. ===== -->

        <!--
            System TTS engine. Once installed and selected in
            Settings → Accessibility → Text-to-speech output, this service
            exposes ReadAloud's voices to every other app on the device —
            TalkBack, Google Maps, Kindle, etc.

            See SYSTEM_TTS_ENGINE_ROADMAP.md for the full plan.
        -->
        <service
            android:name=".systemtts.ReadAloudTTSService"
            android:label="@string/system_tts_engine_name"
            android:exported="true"
            android:permission="android.permission.BIND_TEXT_TO_SPEECH_SERVICE">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <!-- Standard TTS engine contract activities: the example sentence Settings speaks for a
             language, and the list of ready voices. -->
        <activity
            android:name=".systemtts.GetSampleTextActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".systemtts.CheckVoiceDataActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings UI launched from the system TTS engine row (⚙ icon). -->
        <activity
            android:name=".systemtts.TTSEngineSettingsActivity"
            android:label="@string/system_tts_engine_name"
            android:exported="true"
            android:theme="@style/Theme.ListenAI" />

        <!-- Headless benchmark for the system TTS path. Invokes our engine
             via the public TextToSpeech client API and logs precise
             timestamps for every stage. Pair with scrcpy audio capture to
             derive speak()-to-first-audible-sound latency.
             See BenchmartActivity.kt for the launch incantation. -->
        <activity
            android:name=".systemtts.BenchmarkActivity"
            android:label="TTS latency benchmark"
            android:exported="true"
            android:theme="@style/Theme.ListenAI" />

        <!-- Sets the Kokoro EP pref synchronously. Pair with force-stop
             before launching BenchmarkActivity so the next session uses
             the new EP. -->
        <receiver
            android:name=".systemtts.SetEpReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.listenai.SET_EP" />
            </intent-filter>
        </receiver>

        <!-- Test helper: set the in-app selectedVoiceId via adb broadcast. -->
        <receiver
            android:name=".systemtts.SetVoiceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.listenai.SET_VOICE" />
            </intent-filter>
        </receiver>

        <!-- 2026-06-22 Piper spike. Loads en_US-amy-low.onnx from
             external app files dir, runs single inference with
             pre-dumped phoneme IDs, plays the audio. Throwaway. -->
        <activity
            android:name=".systemtts.PiperBenchmarkActivity"
            android:label="Piper latency benchmark"
            android:exported="true"
            android:theme="@style/Theme.ListenAI" />

        <!-- Kokoro variant benchmark — tests alt quantization variants
             (model_quantized, model_uint8, model_uint8f16) against NNAPI
             to see if any actually engages the Tensor SOC instead of
             silently falling back to CPU. -->
        <activity
            android:name=".systemtts.KokoroVariantBenchmarkActivity"
            android:label="Kokoro variant benchmark"
            android:exported="true"
            android:theme="@style/Theme.ListenAI" />

        <!-- eSpeak NG ABI smoke test. Loads libespeak-ng.so +
             libc++_shared.so to verify ABI compatibility before
             committing to full Piper integration. -->
        <activity
            android:name=".systemtts.EspeakSmokeActivity"
            android:label="eSpeak NG smoke test"
            android:exported="true"
            android:theme="@style/Theme.ListenAI" />

    </application>

</manifest>
